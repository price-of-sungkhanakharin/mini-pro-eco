# ==============================================================================
# AI Ecosystem Environment Configuration Template (.env.sample)
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ecosystem

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=user-profiles
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Label Studio Annotation Platform Configuration
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=default_key

# Security & Authentication Settings
SECRET_KEY=super-secret-ai-ecosystem-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
