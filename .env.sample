# ==============================================================================
# AI Ecosystem Environment Configuration Template (.env.sample)
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ecosystem

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ai-ecosystem
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Label Studio Annotation Platform Configuration
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=default_key

# Security & Authentication Settings
SECRET_KEY=super-secret-ai-ecosystem-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# ==============================================================================
# LINE Chatbot & dotBlue AI LLM Settings
# ==============================================================================
LINE_CHANNEL_ID=2011743452
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_PUBLIC_URL=https://your-public-webhook-url.example.com
DOTBLUE_API_KEY=your_dotblue_api_key_here
DOTBLUE_BASE_URL=https://ai.psu.blue/v1
DOTBLUE_MODEL=openai/gpt-5.6-luna

# ==============================================================================
# Private GPU Compute Node Configuration (Self-Hosted NVIDIA GTX 1660 SUPER)
# ==============================================================================
GPU_NODE_BASE_URL=http://172.30.81.175:9000
GPU_NODE_API_KEY=p@ssword
