                <mxCell id="p7_min_user" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:30px;'&gt;👨‍💻&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#B71C1C;'&gt;Admin กดเข้าดูระบบ&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ปุ่ม MinIO หรือ Label Studio&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E53935;strokeWidth=2;arcSize=15;" parent="1" vertex="1">
                    <mxGeometry x="930" y="140" width="200" height="90" as="geometry" />
                </mxCell>
                <mxCell id="p7_min_fastapi" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:28px;'&gt;⚡🔑&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:12px;color:#00695C;'&gt;FastAPI SSO Endpoints&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#004D40;margin-top:4px;line-height:15px;'&gt;• &lt;b&gt;MinIO:&lt;/b&gt; &lt;code&gt;/auth/sso/minio&lt;/code&gt; แลก Cookie &lt;code&gt;token&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Label Studio:&lt;/b&gt; &lt;code&gt;/sso/label-studio&lt;/code&gt; ยิง Auto-Auth&lt;br/&gt;  แลก &lt;code&gt;sessionid&lt;/code&gt; + &lt;code&gt;csrftoken&lt;/code&gt; สู่ &lt;code&gt;/projects/1&lt;/code&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;arcSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="130" width="280" height="110" as="geometry" />
                </mxCell>
