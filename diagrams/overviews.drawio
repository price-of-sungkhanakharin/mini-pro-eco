                <mxCell id="p7_e_a1" value="คลิกลิงก์ :8088" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F51B5;strokeWidth=2;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="p7_adm_user" target="p7_adm_php" edge="1">
