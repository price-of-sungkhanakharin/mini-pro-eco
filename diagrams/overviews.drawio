                <mxCell id="grp_backend_services" value="&lt;b style='font-size:15px;color:#01579B;'&gt;Backend Services (Core AI Platform)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F4FBFD;strokeColor=#0288D1;strokeWidth=2;dashed=1;dashPattern=5 5;fontSize=14;fontStyle=1;startSize=28;rounded=1;arcSize=10;" parent="1" vertex="1">
