                <mxCell id="p2_c3" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:30px;'&gt;📷&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:12px;color:#4A148C;'&gt;CAM-03&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#7B1FA2;font-weight:bold;'&gt;ข้างภาคคอม (มอไซค์)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555;'&gt;ส่งภาพทุก 5-15s&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7B1FA2;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
