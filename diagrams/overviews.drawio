    <diagram id="page_ext_apis" name="6. External APIs Integration Flow">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="p6_title" value="&lt;b style='font-size:18px;color:#4A148C;'&gt;🔌 Pipeline 5: External APIs &amp; LangChain AI Agent Architecture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;strokeWidth=2;arcSize=25;align=center;" parent="1" vertex="1">
                    <mxGeometry x="375" y="20" width="1000" height="45" as="geometry" />
                </mxCell>
                <mxCell id="p6_center" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:44px;'&gt;⚡🏢⚡&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:15px;color:#01579B;'&gt;AI Ecosystem Core Platform&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#555;'&gt;(FastAPI Gateway &amp; Ingestion Server)&lt;/span&gt;&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="695" y="360" width="360" height="190" as="geometry" />
                </mxCell>
                <mxCell id="p6_lc" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🦜🔗&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#4A148C;'&gt;FastAPI Context &amp;amp; RAG Engine&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#4A148C;margin-top:4px;line-height:15px;'&gt;• ดึงสถานะสด: &lt;code&gt;query_postgres_slots()&lt;/code&gt;&lt;br/&gt;• ดึงภาพกล้อง: &lt;code&gt;fetch_minio_snapshot()&lt;/code&gt;&lt;br/&gt;• สรุปสถานะแคช: &lt;code&gt;get_redis_summary()&lt;/code&gt;&lt;br/&gt;• ผสาน Persona ส่งให้ dotBlue AI LLM&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="705" y="590" width="340" height="140" as="geometry" />
                </mxCell>
                <mxCell id="p6_label_studio" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:34px;'&gt;🏷️✍️&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#4A148C;'&gt;1. Label Studio REST API&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;&lt;code&gt;http://localhost:8080&lt;/code&gt; (Self-Hosted)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#4A148C;margin-top:6px;line-height:16px;'&gt;• &lt;b&gt;Endpoint:&lt;/b&gt; &lt;code&gt;http://localhost:8080/api/projects&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Auth:&lt;/b&gt; Token Authentication / Auto-SSO&lt;br/&gt;• &lt;b&gt;ฟังก์ชัน:&lt;/b&gt; นำเข้าภาพ Low Confidence เพื่อ Re-label ROI&lt;br/&gt;• &lt;b&gt;จุดประสงค์:&lt;/b&gt; ส่งออก Dataset สู่ MinIO (&lt;code&gt;datasets/&amp;lt;id&amp;gt;/&lt;/code&gt;)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="80" y="110" width="390" height="190" as="geometry" />
                </mxCell>
                <mxCell id="p6_modal" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:34px;'&gt;🚀🔥&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#1B5E20;'&gt;2. Private GPU Compute Node REST API&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;&lt;code&gt;http://172.30.81.175:9000&lt;/code&gt; (GTX 1660 SUPER 6GB)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#1B5E20;margin-top:6px;line-height:16px;'&gt;• &lt;b&gt;Endpoint:&lt;/b&gt; &lt;code&gt;http://172.30.81.175:9000/api/jobs&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Auth Header:&lt;/b&gt; &lt;code&gt;X-API-Key: p@ssword&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;ฟังก์ชัน:&lt;/b&gt; Pre-flight AST check, Job submit, SSE Log Stream&lt;br/&gt;• &lt;b&gt;จุดประสงค์:&lt;/b&gt; เทรนโมเดลความเร็วสูงผ่าน Zero-Copy NVMe &amp; 0฿ Cloud Cost&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="110" width="390" height="190" as="geometry" />
                </mxCell>
                <mxCell id="p6_line" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:34px;'&gt;💬📱&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#1B5E20;'&gt;3. LINE Messaging API&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;&lt;code&gt;api.line.me/v2/bot&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#1B5E20;margin-top:6px;line-height:16px;'&gt;• &lt;b&gt;Webhook:&lt;/b&gt; &lt;code&gt;POST /api/v1/line/webhook&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Reply &amp; Push:&lt;/b&gt; ส่งข้อความสรุปช่องจอด + รูป Snapshot สด&lt;br/&gt;• &lt;b&gt;Auth:&lt;/b&gt; Channel Secret + Bearer Token&lt;br/&gt;• &lt;b&gt;จุดประสงค์:&lt;/b&gt; แจ้งเตือนผู้ขับขี่ผ่าน LINE ตลอด 24 ชม.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="80" y="620" width="390" height="190" as="geometry" />
                </mxCell>
                <mxCell id="p6_dotblue" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:34px;'&gt;🤖🧠&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#4A148C;'&gt;4. dotBlue AI LLM Service&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;&lt;code&gt;openai/gpt-5.6-luna&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#4A148C;margin-top:6px;line-height:16px;'&gt;• &lt;b&gt;Protocol:&lt;/b&gt; OpenAI-Compatible &lt;code&gt;POST /v1/chat/completions&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Persona:&lt;/b&gt; 'น้องจ๊อด หาที่จอดรถ' ประจำ ม.อ.&lt;br/&gt;• &lt;b&gt;Context RAG:&lt;/b&gt; ประมวลผลผลลัพธ์จาก Postgres &amp; MinIO Snapshots&lt;br/&gt;• &lt;b&gt;จุดประสงค์:&lt;/b&gt; ตอบคำถามอัจฉริยะแบบ RAG โดยไม่ต้องเทรนโมเดลใหม่&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="620" width="390" height="190" as="geometry" />
                </mxCell>
