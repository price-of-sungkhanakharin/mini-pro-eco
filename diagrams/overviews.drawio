                <mxCell id="box_modal" value="&lt;div style='text-align:center;padding:6px;'&gt;&lt;span style='font-size:32px;'&gt;🚀🔥&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#1B5E20;'&gt;Private GPU Compute Node&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;NVIDIA GTX 1660 SUPER (6GB)&lt;br/&gt;&lt;code&gt;http://172.30.81.175:9000&lt;/code&gt;&lt;br/&gt;Zero-Copy NVMe &amp; 0฿ Cloud Cost&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
