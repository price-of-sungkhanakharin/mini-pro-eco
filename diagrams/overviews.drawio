                <mxCell id="p5_ce2" value="Real Context &amp; Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=2;startArrow=classic;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="p5_c_lc" target="p5_c_llm" edge="1">
