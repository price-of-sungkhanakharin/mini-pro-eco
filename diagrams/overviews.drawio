                <mxCell id="p7_minio_grp" value="&lt;b style='font-size:14px;color:#B71C1C;'&gt;2. MinIO S3 (:9001) &amp; Label Studio (:8080) - Seamless SSO Auto-Login&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=1.5;startSize=28;rounded=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="900" y="85" width="800" height="460" as="geometry" />
