                <mxCell id="1" parent="0" />
                <mxCell id="p2_title" value="&lt;b style='font-size:18px;color:#1B5E20;'&gt;📷 Pipeline 1: CCTV Ingestion, MinIO Storage &amp; Real-Time YOLO Detection Pipeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=25;align=center;" parent="1" vertex="1">
