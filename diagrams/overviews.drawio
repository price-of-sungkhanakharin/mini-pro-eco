                <mxCell id="p5_t2_box" value="&lt;b style='font-size:14px;color:#4A148C;'&gt;Track 2: Model 2 - LINE Chatbot &amp; dotBlue AI Agent (dotBlue LLM openai/gpt-5.6-luna - Pure Inference, No Weights Training)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;startSize=26;rounded=1;arcSize=10;" parent="1" vertex="1">
