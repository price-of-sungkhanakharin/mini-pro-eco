                <mxCell id="p2_db_redis" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🐘⚡&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#0D47A1;'&gt;2. PostgreSQL &amp;amp; Redis Sync&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#0D47A1;line-height:14px;'&gt;บันทึก &lt;code&gt;park_status&lt;/code&gt; &amp;amp; &lt;code&gt;occupancy_logs&lt;/code&gt;&lt;br/&gt;แคชสถานะช่องจอดใน Redis (&amp;lt;0.5ms)&lt;br/&gt;กระจายข้อมูลสู่ Dashboard &amp;amp; LINE Bot&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="215" width="270" height="130" as="geometry" />
                </mxCell>
                <mxCell id="p2_dash" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;💻📊&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#00838F;'&gt;React Dashboard (:5173)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;แสดงผลช่องจอดสด +&lt;br/&gt;ภาพกล้องสด &amp;amp; ROI Polygon Visual&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00BCD4;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="135" width="230" height="110" as="geometry" />
                </mxCell>
                <mxCell id="p2_line" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;💬📱&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1B5E20;'&gt;LINE Chatbot ('น้องจ๊อด')&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ตอบคำถามช่องว่างตามจริง &amp;amp;&lt;br/&gt;ส่งภาพกล้อง Snapshot สดจาก MinIO&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="310" width="230" height="110" as="geometry" />
