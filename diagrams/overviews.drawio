                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p5_ce5" value="นำมาปรับปรุง Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E91E63;strokeWidth=2;endArrow=classic;fontSize=10;fontColor=#C2185B;labelBackgroundColor=#ffffff;" parent="1" source="p5_c_dblog" target="p5_c_tune" edge="1">
                    <mxGeometry relative="1" as="geometry" />
