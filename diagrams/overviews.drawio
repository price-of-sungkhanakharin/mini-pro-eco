                    <mxGeometry x="50" y="350" width="180" height="100" as="geometry" />
                </mxCell>
                <mxCell id="p2_ingest" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🖥️⚡&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#E65100;'&gt;เซิร์ฟเวอร์รับภาพ (:5005)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ปรับและตรวจสอบข้อมูลภาพ&lt;br/&gt;(หมุน 180° • ปรับแสง • JSON Sidecar)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="300" y="220" width="210" height="120" as="geometry" />
                </mxCell>
                <mxCell id="p2_disk" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:26px;'&gt;💾&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:11px;color:#B78103;'&gt;Local Disk&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555;'&gt;&lt;code&gt;data/dataset/camX/...&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="570" y="150" width="200" height="95" as="geometry" />
                </mxCell>
                <mxCell id="p2_minio" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:26px;'&gt;🪣&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:11px;color:#C62828;'&gt;MinIO Storage&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555;'&gt;Bucket: &lt;code&gt;raw-datasets&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="570" y="275" width="200" height="95" as="geometry" />
                </mxCell>
                <mxCell id="p2_yolo" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🧠🚗&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#4A148C;'&gt;1. YOLO ตรวจจับรถบน CPU&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;คำนวณจำนวนรถจอดปัจจุบัน&lt;br/&gt;(ROI Slot Intersection &amp; Density)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="830" y="215" width="230" height="130" as="geometry" />
                </mxCell>
                <mxCell id="p2_sarimax" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;📈⏱️&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#004D40;'&gt;2. SARIMAX Time-Series Forecaster&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#004D40;line-height:14px;'&gt;ดึงประวัติการจอด (occupancy_logs) จาก Postgres&lt;br/&gt;&lt;b&gt;พยากรณ์ความน่าจะเป็นว่าง (+15 นาที):&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#2E7D32;'&gt;● สูง&lt;/span&gt; | &lt;span style='color:#F57F17;'&gt;● กลาง&lt;/span&gt; | &lt;span style='color:#C62828;'&gt;● เต็ม&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2.5;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="215" width="270" height="130" as="geometry" />
                </mxCell>
                <mxCell id="p2_dash" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;💻📊&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#00838F;'&gt;แสดงผลบน Dashboard&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;แสดงผลช่องจอดสด +&lt;br/&gt;Badge คาดการณ์ว่าง +15น. (:5173)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00BCD4;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="135" width="230" height="110" as="geometry" />
                </mxCell>
                <mxCell id="p2_line" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;💬📱&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1B5E20;'&gt;ส่งข้อมูลให้ LINE Chatbot&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ตอบคำถามว่างสด &amp; พยากรณ์ล่วงหน้า&lt;br/&gt;('น้องจ๊อด หาที่จอดรถ')&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="310" width="230" height="110" as="geometry" />
                </mxCell>
                <mxCell id="p2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0288D1;strokeWidth=2;endArrow=classic;" parent="1" source="p2_c1" target="p2_ingest" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=classic;" parent="1" source="p2_c2" target="p2_ingest" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7B1FA2;strokeWidth=2;endArrow=classic;" parent="1" source="p2_c3" target="p2_ingest" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e4" value="บันทึกไฟล์คู่ขนาน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFA000;strokeWidth=1.5;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="p2_ingest" target="p2_disk" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e5" value="จัดเก็บ S3 Bucket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E53935;strokeWidth=1.5;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="p2_ingest" target="p2_minio" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e6" value="อ่านรูปภาพ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="p2_minio" target="p2_yolo" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e7" value="จำนวนรถปัจจุบัน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2.5;endArrow=classic;fontSize=10;fontColor=#E65100;fontStyle=1;labelBackgroundColor=#ffffff;" parent="1" source="p2_yolo" target="p2_sarimax" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p2_e8" value="สถานะสด + Badge ว่าง +15น." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00BCD4;strokeWidth=2;endArrow=classic;fontSize=10;fontColor=#00838F;labelBackgroundColor=#ffffff;" parent="1" source="p2_sarimax" target="p2_dash" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1400" y="250" />
                            <mxPoint x="1440" y="250" />
                            <mxPoint x="1440" y="190" />
                            <mxPoint x="1470" y="190" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2_e9" value="แจ้งเตือน &amp; ตอบคำถามล่วงหน้า" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=classic;fontSize=10;fontColor=#1B5E20;labelBackgroundColor=#ffffff;" parent="1" source="p2_sarimax" target="p2_line" edge="1">
                    <mxGeometry relative="1" as="geometry">
