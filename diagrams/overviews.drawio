    <diagram id="page_device_mgmt" name="3. Camera Device Management">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="p3_title" value="&lt;b style='font-size:18px;color:#4A148C;'&gt;⚙️ Pipeline 2: การจัดการและควบคุมกล้องทางไกลผ่าน Admin Interface&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;strokeWidth=2;arcSize=25;align=center;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="900" height="45" as="geometry" />
                </mxCell>
                <mxCell id="p3_admin" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:36px;'&gt;👨‍💻&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:14px;color:#C2185B;'&gt;ผู้ดูแลระบบเข้าสู่ Admin Interface&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ยืนยันตัวตนผ่าน JWT Security System&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="100" width="340" height="85" as="geometry" />
                </mxCell>
                <mxCell id="p3_select" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;📍🔍&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#0D47A1;'&gt;เลือกพื้นที่และจุดติดตั้งกล้อง&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;CAM-01, CAM-02, หรือ CAM-03&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="215" width="340" height="80" as="geometry" />
                </mxCell>
                <mxCell id="p3_check" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;📡📶&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1B5E20;'&gt;ตรวจสอบสถานะกล้อง ESP32&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;Heartbeat ล่าสุด, WiFi RSSI, Heap Memory &amp; Uptime&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="325" width="340" height="85" as="geometry" />
                </mxCell>
                <mxCell id="p3_config" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🎛️📝&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#E65100;'&gt;กำหนดค่าที่ต้องการอัปเดต&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;เช่น ค่ารับแสง (Exposure), ความละเอียด, และรอบส่งภาพ (Interval)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="440" width="340" height="85" as="geometry" />
                </mxCell>
                <mxCell id="p3_send" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🚀📡&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#00695C;'&gt;เซิร์ฟเวอร์ส่งคำสั่งไปยัง ESP32&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ส่ง Command ผ่าน HTTP POST / OTA Sync&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="555" width="340" height="80" as="geometry" />
                </mxCell>
                <mxCell id="p3_apply" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;📥🔄&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#004D40;'&gt;ESP32 รับคำสั่งและปรับใช้การตั้งค่า&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ปรับรีจิสเตอร์เซนเซอร์ OV2640 และบันทึกลง Flash Memory&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00796B;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="665" width="340" height="80" as="geometry" />
                </mxCell>
                <mxCell id="p3_loop" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:32px;'&gt;🔁✨&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1B5E20;'&gt;ESP32 ทำงานต่อเนื่องและส่งภาพกลับ&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ส่งภาพทุก 5 วินาที ตามค่าใหม่ที่ปรับปรุงแล้ว&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="775" width="340" height="80" as="geometry" />
                </mxCell>
                <mxCell id="p3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E91E63;strokeWidth=2;endArrow=classic;" parent="1" source="p3_admin" target="p3_select" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=classic;" parent="1" source="p3_select" target="p3_check" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=classic;" parent="1" source="p3_check" target="p3_config" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=classic;" parent="1" source="p3_config" target="p3_send" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00897B;strokeWidth=2;endArrow=classic;" parent="1" source="p3_send" target="p3_apply" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="p3_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00796B;strokeWidth=2;endArrow=classic;" parent="1" source="p3_apply" target="p3_loop" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page_active_learning" name="4. Active Learning &amp; Feedback Loop">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="p4_title" value="&lt;b style='font-size:18px;color:#0D47A1;'&gt;🎯 Pipeline 3: Active Learning &amp; Feedback Loop เมื่อค่าความมั่นใจต่ำ (&amp;lt; 40%)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;arcSize=25;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="20" width="950" height="45" as="geometry" />
                </mxCell>
                <mxCell id="p4_step1" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:34px;'&gt;🧠🚗&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1565C0;'&gt;ระบบตรวจจับรถจากภาพ&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;รับเฟรมภาพสดจากกล้องและทำ Inference&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565C0;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="500" y="100" width="320" height="85" as="geometry" />
                </mxCell>
                <mxCell id="p4_decide" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:26px;'&gt;❓⚖️&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#E65100;'&gt;ค่าความมั่นใจต่ำกว่า 40% หรือไม่?&lt;/b&gt;&lt;/div&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="220" width="320" height="120" as="geometry" />
                </mxCell>
                <mxCell id="p4_success" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:34px;'&gt;✅📊&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1B5E20;'&gt;บันทึกผลตรวจจับและแสดงผล&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;ความมั่นใจ &amp;ge; 40% อัปเดตขึ้น Dashboard ทันที&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="940" y="225" width="270" height="110" as="geometry" />
                </mxCell>
                <mxCell id="p4_store" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:30px;'&gt;📥📁&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#880E4F;'&gt;จัดเก็บภาพไว้ใน Feedback Loop&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;บันทึกลง Postgres (Flag: NEEDS_REVIEW)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="530" y="390" width="260" height="85" as="geometry" />
                </mxCell>
                <mxCell id="p4_relabel" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:30px;'&gt;✍️🧐&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#4A148C;'&gt;ตรวจสอบและติดป้ายกำกับข้อมูลใหม่&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;Roboflow Annotate &amp; Review Queue&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;arcSize=18;" parent="1" vertex="1">
                    <mxGeometry x="530" y="510" width="260" height="85" as="geometry" />
                </mxCell>
