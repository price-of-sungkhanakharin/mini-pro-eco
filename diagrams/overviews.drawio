    <diagram id="page_sso_sync" name="7. SSO &amp; Real-Time Sync Pipeline">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="p7_title" value="&lt;b style='font-size:18px;color:#0D47A1;'&gt;🔐 Pipeline 6: Seamless SSO Auto-Login, 3-Tier Vacancy Predictor &amp; Real-Time Slot Merge&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;arcSize=25;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="20" width="1150" height="45" as="geometry" />
                </mxCell>
                <mxCell id="p7_adminer_grp" value="&lt;b style='font-size:14px;color:#1A237E;'&gt;1. Adminer Database UI (:8088) - Zero-Click Auto-Login SSO&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5C6BC0;strokeWidth=1.5;startSize=28;rounded=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="85" width="780" height="460" as="geometry" />
                </mxCell>
                <mxCell id="p7_adm_user" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:30px;'&gt;👨‍💻&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1A237E;'&gt;Admin กดเปิด DB UI&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;จากหน้า Ecosystem View&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F51B5;strokeWidth=2;arcSize=15;" parent="1" vertex="1">
                    <mxGeometry x="70" y="140" width="200" height="90" as="geometry" />
                </mxCell>
                <mxCell id="p7_adm_php" value="&lt;div style='text-align:left;padding:6px;'&gt;&lt;div style='text-align:center;'&gt;&lt;span style='font-size:28px;'&gt;🐘⚡&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:12px;color:#1A237E;'&gt;Custom Adminer Plugin (index.php)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#283593;margin-top:4px;line-height:15px;'&gt;• Overrides &lt;code&gt;login()&lt;/code&gt; &amp; &lt;code&gt;credentials()&lt;/code&gt;&lt;br/&gt;• ดึงค่า &lt;code&gt;POSTGRES_USER&lt;/code&gt; &amp; &lt;code&gt;PASSWORD&lt;/code&gt; อัตโนมัติ&lt;br/&gt;• &lt;code&gt;$_POST['auth'] = [...]&lt;/code&gt; ข้ามหน้า Login ทันที&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#3F51B5;strokeWidth=2;arcSize=15;" parent="1" vertex="1">
                    <mxGeometry x="310" y="130" width="270" height="110" as="geometry" />
                </mxCell>
                <mxCell id="p7_adm_dash" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:30px;'&gt;🗄️📊&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:13px;color:#1B5E20;'&gt;เข้าสู่หน้าจัดการ PostgreSQL ทันที&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;พร้อมดูตาราง &lt;code&gt;park_status&lt;/code&gt;, &lt;code&gt;occupancy_logs&lt;/code&gt;, และ ROI&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;arcSize=15;" parent="1" vertex="1">
