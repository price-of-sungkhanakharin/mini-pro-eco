/*
 ============================================================================
  AI Ecosystem Platform - Camera 1 (Front Department: Cars)
  Target Hardware : AI-Thinker ESP32-CAM (OV2640)
  Destination     : MinIO Dataset Storage via FastAPI Gateway (Port 8000)
  Location ID     : front_dept
  Security        : Automated JWT Bearer Access Token Authentication
  Network         : PSU WiFi (802.1x EAP-PEAP) or WPA2
 ============================================================================
*/

#include "esp_camera.h"
#include <WiFi.h>
#include <HTTPClient.h>

// ============================================================================
// Network Configuration
// ============================================================================
#define USE_PSU_WIFI

#ifdef USE_PSU_WIFI
  #include "esp_eap_client.h"
  const char* ssid         = "PSU WiFi (802.1x)";
  const char* eap_identity = "6710110589";
  const char* eap_username = "6710110589";
  const char* eap_password = "Chokun02..";
#else
  const char* ssid     = "YOUR_WIFI_NAME";
  const char* password = "YOUR_WIFI_PASSWORD";
#endif

// ============================================================================
// Server & Authentication Configuration (LAN Access)
// ============================================================================
const char* serverIp   = "172.30.228.51"; 
const int   serverPort = 8000;
const char* locationId = "front_dept";

// Camera User Account for JWT Token Authentication
const char* authUsername = "camera_front@aieco.com";
const char* authPassword = "p@ssword";

// Stored JWT Token
String jwtToken = "";

// Upload Interval (e.g. every 5 seconds)
const unsigned long uploadIntervalMs = 5000;
unsigned long lastUploadTime = 0;

// AI-Thinker Camera Pin Definitions
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27
#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5
#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22
#define LED_STATUS_PIN    33
#define FLASH_LED_PIN      4

// ============================================================================
// Initialize OV2640 Camera
// ============================================================================
bool initCamera() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;
  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  if (psramFound()) {
    config.frame_size   = FRAMESIZE_HD;   // 1280x720 HD Widescreen
    config.jpeg_quality = 8;              // Sharp details, low compression
    config.fb_count     = 2;
    config.grab_mode    = CAMERA_GRAB_LATEST;
  } else {
    config.frame_size   = FRAMESIZE_SVGA; // 800x600 fallback
    config.jpeg_quality = 10;
    config.fb_count     = 1;
  }

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("[CAMERA_ERR] Camera init failed with error 0x%x\n", err);
    return false;
  }

  sensor_t *s = esp_camera_sensor_get();
  if (s != NULL) {
    s->set_brightness(s, 1);     // Crisp lighting
    s->set_contrast(s, 1);       // Sharpen edges & license plates
    s->set_whitebal(s, 1);       // Auto White Balance
    s->set_awb_gain(s, 1);       // Auto White Balance Gain
    s->set_exposure_ctrl(s, 1);  // Auto Exposure
    s->set_gain_ctrl(s, 1);      // Auto Gain
    s->set_lenc(s, 1);           // Lens Correction (fixes edge blur)
    s->set_bpc(s, 1);            // Black Pixel Correction
    s->set_wpc(s, 1);            // White Pixel Correction
  }
  return true;
}

// ============================================================================
// Connect to WiFi
// ============================================================================
void connectWiFi() {
  Serial.printf("[WIFI] Connecting to %s ...\n", ssid);
  WiFi.disconnect(true);
  delay(500);
  WiFi.mode(WIFI_STA);

#ifdef USE_PSU_WIFI
  esp_eap_client_set_identity((const unsigned char *)eap_identity, strlen(eap_identity));
  esp_eap_client_set_username((const unsigned char *)eap_username, strlen(eap_username));
  esp_eap_client_set_password((const unsigned char *)eap_password, strlen(eap_password));
  esp_wifi_sta_enterprise_enable();
  WiFi.begin(ssid);
#else
  WiFi.begin(ssid, password);
#endif

  int retries = 0;
  while (WiFi.status() != WL_CONNECTED && retries < 40) {
    delay(500);
    Serial.print(".");
    retries++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n[WIFI_OK] Connected! Camera Local IP: " + WiFi.localIP().toString());
  } else {
    Serial.println("\n[WIFI_ERR] Failed to connect to WiFi.");
  }
}

// ============================================================================
// Authenticate with FastAPI Backend & Obtain JWT Access Token
// ============================================================================
bool loginServer() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
    if (WiFi.status() != WL_CONNECTED) return false;
  }

  String loginUrl = String("http://") + serverIp + ":" + String(serverPort) + "/api/v1/auth/login";
  Serial.printf("[AUTH] Logging in to %s ...\n", loginUrl.c_str());

  HTTPClient http;
  http.begin(loginUrl);
  http.setTimeout(7000);
  http.addHeader("Content-Type", "application/x-www-form-urlencoded");

  String payload = String("username=") + authUsername + "&password=" + authPassword;
  int httpCode = http.POST(payload);

  if (httpCode == 200) {
    String response = http.getString();
    // Parse JSON access_token
    int tokenStart = response.indexOf("\"access_token\":\"");
    if (tokenStart != -1) {
      tokenStart += 16;
      int tokenEnd = response.indexOf("\"", tokenStart);
      if (tokenEnd != -1) {
        jwtToken = response.substring(tokenStart, tokenEnd);
        Serial.println("[AUTH_OK] Successfully authenticated! JWT Token acquired.");
        http.end();
        return true;
      }
    }
  }

  Serial.printf("[AUTH_ERR] Login failed with HTTP code: %d\n", httpCode);
  jwtToken = "";
  http.end();
  return false;
}

// ============================================================================
// Capture Frame and Stream to MinIO Dataset Endpoint
// ============================================================================
void captureAndUpload() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
    return;
  }

  // Ensure valid JWT Access Token
  if (jwtToken == "") {
    if (!loginServer()) {
      Serial.println("[UPLOAD_ERR] Cannot upload: No valid JWT token.");
      return;
    }
  }

  digitalWrite(LED_STATUS_PIN, LOW); // LED indicator ON

  camera_fb_t* fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("[CAMERA_ERR] Camera capture failed.");
    digitalWrite(LED_STATUS_PIN, HIGH);
    return;
  }

  // Destination: Direct MinIO Dataset Storage endpoint in FastAPI
  String uploadUrl = String("http://") + serverIp + ":" + String(serverPort) +
                     "/api/v1/datasets/camera-upload?location=" + locationId;

  HTTPClient http;
  http.begin(uploadUrl);
  http.setTimeout(10000);
  http.addHeader("Authorization", String("Bearer ") + jwtToken);
  http.addHeader("Content-Type", "image/jpeg");

  int httpCode = http.POST(fb->buf, fb->len);

  if (httpCode == 200 || httpCode == 201) {
    Serial.printf("[MINIO_OK] [%s] Frame stored in MinIO (%u bytes, Code: %d)\n", locationId, fb->len, httpCode);
  } else if (httpCode == 401) {
    Serial.println("[AUTH_WARN] 401 Unauthorized: JWT token expired. Clearing token for re-login.");
    jwtToken = ""; // Trigger re-login on next attempt
  } else {
    Serial.printf("[UPLOAD_ERR] Upload failed (HTTP Code: %d)\n", httpCode);
  }

  http.end();
  esp_camera_fb_return(fb);

  digitalWrite(LED_STATUS_PIN, HIGH); // LED indicator OFF
}

// ============================================================================
// Setup & Main Loop
// ============================================================================
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n=== Starting AI Ecosystem IoT Camera (Front Department) ===");

  pinMode(LED_STATUS_PIN, OUTPUT);
  digitalWrite(LED_STATUS_PIN, HIGH); // Off initially (Active LOW)

  pinMode(FLASH_LED_PIN, OUTPUT);
  digitalWrite(FLASH_LED_PIN, LOW);   // Flash off

  if (!initCamera()) {
    Serial.println("[SYSTEM_ERR] Camera init failed. Restarting in 5 seconds...");
    delay(5000);
    ESP.restart();
  }

  connectWiFi();

  // Perform initial login test
  if (WiFi.status() == WL_CONNECTED) {
    loginServer();
  }
}

void loop() {
  unsigned long now = millis();
  if (now - lastUploadTime >= uploadIntervalMs) {
    lastUploadTime = now;
    captureAndUpload();
  }
  delay(50);
}
