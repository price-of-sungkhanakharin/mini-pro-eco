#!/usr/bin/env bash
# ==============================================================================
# AI Ecosystem Service Management Script (scripts/manage)
# Easily start, stop, restart, and inspect background services individually or all together.
# ==============================================================================

set -e

# Resolve target script directory even if invoked through symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
RESOLVED_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [ -f "$RESOLVED_DIR/compose.yml" ]; then
    ROOT_DIR="$RESOLVED_DIR"
elif [ -f "$RESOLVED_DIR/../compose.yml" ]; then
    ROOT_DIR="$(cd "$RESOLVED_DIR/.." && pwd)"
else
    ROOT_DIR="$RESOLVED_DIR"
fi

LOGS_DIR="$ROOT_DIR/logs"
FRONTEND_DIR="$ROOT_DIR/frontend"
FRONTEND_PID_FILE="$LOGS_DIR/frontend.pid"
FRONTEND_LOG_FILE="$LOGS_DIR/frontend.log"

mkdir -p "$LOGS_DIR"
cd "$ROOT_DIR"

# Text Colors
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
NC="\033[0m" # No Color

print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[OK]${NC} $1"; }
print_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# ------------------------------------------------------------------------------
# Helper Functions for Frontend Process Management
# ------------------------------------------------------------------------------
is_frontend_running() {
    if [ -f "$FRONTEND_PID_FILE" ]; then
        local pid
        pid=$(cat "$FRONTEND_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    # Check by listening port 5173 as fallback
    local lsof_pid
    lsof_pid=$(lsof -ti :5173 2>/dev/null || true)
    if [ -n "$lsof_pid" ]; then
        echo "$lsof_pid" > "$FRONTEND_PID_FILE"
        return 0
    fi
    return 1
}

start_frontend() {
    if is_frontend_running; then
        local pid
        pid=$(cat "$FRONTEND_PID_FILE" 2>/dev/null || true)
        print_warn "Frontend is already running in background (PID: $pid) on http://0.0.0.0:5173"
        return 0
    fi

    print_info "Starting Frontend (Vite React) in background..."
    if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
        print_info "Installing frontend dependencies first (npm install)..."
        (cd "$FRONTEND_DIR" && npm install)
    fi

    (
        cd "$FRONTEND_DIR"
        setsid ./node_modules/.bin/vite --host 0.0.0.0 </dev/null > "$FRONTEND_LOG_FILE" 2>&1 &
        echo $! > "$FRONTEND_PID_FILE"
    )

    sleep 2
    if is_frontend_running; then
        local pid
        pid=$(cat "$FRONTEND_PID_FILE")
        print_success "Frontend started successfully in background (PID: $pid) -> http://0.0.0.0:5173"
        print_info "Frontend logs: $FRONTEND_LOG_FILE"
    else
        print_error "Frontend failed to start. Check logs at: $FRONTEND_LOG_FILE"
        return 1
    fi
}

stop_frontend() {
    local stopped=0
    if [ -f "$FRONTEND_PID_FILE" ]; then
        local pid
        pid=$(cat "$FRONTEND_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            print_info "Stopping Frontend process (PID: $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 1
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
            fi
            stopped=1
        fi
        rm -f "$FRONTEND_PID_FILE"
    fi

    # Also clean up any lingering process on port 5173
    local port_pids
    port_pids=$(lsof -ti :5173 2>/dev/null || true)
    if [ -n "$port_pids" ]; then
        print_info "Killing lingering processes on port 5173 ($port_pids)..."
        echo "$port_pids" | xargs kill -9 2>/dev/null || true
        stopped=1
    fi

    if [ "$stopped" -eq 1 ]; then
        print_success "Frontend stopped."
    else
        print_warn "Frontend was not running."
    fi
}

# ------------------------------------------------------------------------------
# Map service names to Docker compose services
# ------------------------------------------------------------------------------
normalize_service() {
    case "$1" in
        all) echo "all" ;;
        frontend|ui|web) echo "frontend" ;;
        backend|fastapi|api) echo "fastapi" ;;
        trainer|worker|trainer-worker) echo "trainer-worker" ;;
        db|postgres|postgresql) echo "db" ;;
        redis) echo "redis" ;;
        minio|s3) echo "minio" ;;
        label-studio|labelstudio) echo "label-studio" ;;
        infra) echo "infra" ;;
        *) echo "$1" ;;
    esac
}

# ------------------------------------------------------------------------------
# Core Actions: Start, Stop, Restart, Status, Logs
# ------------------------------------------------------------------------------
do_start() {
    local target="$1"
    local service
    service=$(normalize_service "$target")

    case "$service" in
        all)
            print_info "Starting ALL services in background (Docker containers + Frontend)..."
            docker compose up -d
            start_frontend
            echo ""
            print_success "All services have been started!"
            do_status
            ;;
        frontend)
            start_frontend
            ;;
        infra)
            print_info "Starting Infrastructure services (db, redis, minio, label-studio)..."
            docker compose up -d db redis minio label-studio
            print_success "Infrastructure services started."
            ;;
        fastapi|trainer-worker|db|redis|minio|label-studio)
            print_info "Starting Docker container: $service..."
            docker compose up -d "$service"
            print_success "Container '$service' started."
            ;;
        *)
            print_error "Unknown service '$target'."
            print_usage
            exit 1
            ;;
    esac
}

do_stop() {
    local target="$1"
    local service
    service=$(normalize_service "$target")

    case "$service" in
        all)
            print_info "Stopping ALL services (Docker containers + Frontend)..."
            stop_frontend
            docker compose stop
            print_success "All services stopped."
            ;;
        frontend)
            stop_frontend
            ;;
        infra)
            print_info "Stopping Infrastructure services (db, redis, minio, label-studio)..."
            docker compose stop db redis minio label-studio
            print_success "Infrastructure services stopped."
            ;;
        fastapi|trainer-worker|db|redis|minio|label-studio)
            print_info "Stopping container: $service..."
            docker compose stop "$service"
            print_success "Container '$service' stopped."
            ;;
        *)
            print_error "Unknown service '$target'."
            print_usage
            exit 1
            ;;
    esac
}

do_restart() {
    local target="$1"
    local service
    service=$(normalize_service "$target")

    case "$service" in
        all)
            print_info "Restarting ALL services..."
            do_stop all
            sleep 1
            do_start all
            ;;
        frontend)
            stop_frontend
            sleep 1
            start_frontend
            ;;
        infra)
            print_info "Restarting Infrastructure services..."
            docker compose restart db redis minio label-studio
            print_success "Infrastructure services restarted."
            ;;
        fastapi|trainer-worker|db|redis|minio|label-studio)
            print_info "Restarting container: $service..."
            docker compose restart "$service"
            print_success "Container '$service' restarted."
            ;;
        *)
            print_error "Unknown service '$target'."
            print_usage
            exit 1
            ;;
    esac
}

do_status() {
    echo -e "${CYAN}======================================================${NC}"
    echo -e "${CYAN}             AI ECOSYSTEM SYSTEM STATUS               ${NC}"
    echo -e "${CYAN}======================================================${NC}"

    # 1. Frontend Status
    if is_frontend_running; then
        local pid
        pid=$(cat "$FRONTEND_PID_FILE" 2>/dev/null || lsof -ti :5173 2>/dev/null || true)
        echo -e " Frontend (Vite)    : ${GREEN}RUNNING${NC} (PID: ${pid}) -> http://localhost:5173"
    else
        echo -e " Frontend (Vite)    : ${RED}STOPPED${NC}"
    fi

    # 2. Docker Containers Status
    echo ""
    echo -e "${YELLOW}Docker Containers:${NC}"
    docker compose ps
    echo -e "${CYAN}======================================================${NC}"
}

do_logs() {
    local target="$1"
    local lines="${2:-50}"
    local service
    service=$(normalize_service "$target")

    case "$service" in
        frontend)
            print_info "Showing last $lines lines of Frontend logs ($FRONTEND_LOG_FILE):"
            tail -n "$lines" -f "$FRONTEND_LOG_FILE"
            ;;
        all|"")
            docker compose logs --tail="$lines" -f
            ;;
        fastapi|trainer-worker|db|redis|minio|label-studio)
            docker compose logs "$service" --tail="$lines" -f
            ;;
        *)
            print_error "Unknown service '$target' for logs."
            exit 1
            ;;
    esac
}

print_usage() {
    echo -e "${CYAN}Usage:${NC}"
    echo "  ./scripts/manage <command> [service]"
    echo ""
    echo -e "${CYAN}Commands:${NC}"
    echo "  start   <service>    Start service(s) in background"
    echo "  stop    <service>    Stop service(s)"
    echo "  restart <service>    Restart service(s)"
    echo "  status               Show status of all services"
    echo "  logs    [service]    Follow logs for a service"
    echo ""
    echo -e "${CYAN}Services:${NC}"
    echo "  all                  All services (Docker + Frontend) [Default]"
    echo "  frontend             Vite React UI (Port 5173)"
    echo "  backend (or fastapi) FastAPI Gateway Server (Port 8000)"
    echo "  trainer              ARQ Background Trainer Worker"
    echo "  infra                All backing infrastructure (db, redis, minio, label-studio)"
    echo "  db                   PostgreSQL Database (Port 5432)"
    echo "  redis                Redis Cache & Queue (Port 6379)"
    echo "  minio                MinIO Object Storage (Ports 9000, 9001)"
    echo "  label-studio         Label Studio Platform (Port 8080)"
    echo ""
    echo -e "${CYAN}Examples:${NC}"
    echo "  ./scripts/manage start all"
    echo "  ./scripts/manage stop all"
    echo "  ./scripts/manage restart backend"
    echo "  ./scripts/manage status"
    echo "  ./scripts/manage logs frontend"
}

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------
ACTION="${1:-status}"
TARGET="${2:-all}"

case "$ACTION" in
    start)
        do_start "$TARGET"
        ;;
    stop)
        do_stop "$TARGET"
        ;;
    restart)
        do_restart "$TARGET"
        ;;
    status)
        do_status
        ;;
    logs)
        do_logs "$TARGET" "${3:-50}"
        ;;
    help|--help|-h)
        print_usage
        ;;
    *)
        print_error "Invalid action '$ACTION'."
        print_usage
        exit 1
        ;;
esac
